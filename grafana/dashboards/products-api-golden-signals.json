                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(rate(http_server_request_duration_seconds_count[5m]))",
                        "legendFormat": "__auto",
                        "range": true
